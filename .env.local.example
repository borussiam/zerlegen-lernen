# Neon Postgres connection used by server-side vocabulary persistence.
# Use a pooled connection string in serverless production.
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/database?sslmode=require

# AI generation is disabled unless this flag is explicitly enabled.
NEXT_PUBLIC_AI_ENABLED=false

# AI provider for /api/ai/generate. ollama uses no API key; openai/groq use server-only keys.
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini

# OpenAI API key used only by the server-side AI route when enabled.
OPENAI_API_KEY=sk-your-api-key

# Optional provider endpoints.
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
GROQ_API_KEY=gsk-your-api-key
GROQ_BASE_URL=https://api.groq.com/openai/v1/chat/completions
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Backward-compatible overrides still recognized by the route.
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini

# Used only by `npm run data:audit` for German-to-English example backfills.
GOOGLE_TRANSLATE_API_KEY=your-google-cloud-translation-api-key
