# Neon Postgres connection used by server-side vocabulary persistence.
# Use a pooled connection string in serverless production.
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/database?sslmode=require

# AI generation is disabled unless this flag is explicitly enabled.
NEXT_PUBLIC_AI_ENABLED=false

# OpenAI API key used only by the server-side /api/generate route when enabled.
OPENAI_API_KEY=sk-your-api-key

# Override these when using another OpenAI-compatible provider or model.
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini

# Used only by `npm run data:audit` for German-to-English example backfills.
GOOGLE_TRANSLATE_API_KEY=your-google-cloud-translation-api-key
